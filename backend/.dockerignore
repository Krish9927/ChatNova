# .dockerignore — tells Docker WHAT NOT to copy into the build context
# Works exactly like .gitignore but for Docker builds

# Dependencies — will be reinstalled fresh inside the container
node_modules

# Environment files — secrets must NEVER be baked into an image
# Pass secrets via environment variables at runtime
.env
.env.*

# Git history — not needed in production container
.git
.gitignore

# Development tools
*.md
.vscode
.idea

# Log files
*.log
npm-debug.log*

# Test files — not needed in production image
*.test.js
*.spec.js
__tests__/
coverage/

# Docker files themselves (no need to copy them into the image)
Dockerfile
docker-compose.yml
.dockerignore
